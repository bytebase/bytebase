        "views": [
          {
            "name": "MONTHLY_SALES",
            "definition": "SELECT \n    EXTRACT(YEAR FROM SALE_DATE) AS YEAR_VAL,\n    EXTRACT(MONTH FROM SALE_DATE) AS MONTH_VAL,\n    SUM(SALE_AMOUNT) AS TOTAL_SALES\nFROM SALES\nGROUP BY EXTRACT(YEAR FROM SALE_DATE), EXTRACT(MONTH FROM SALE_DATE)",
            "dependencyColumns": [
