        "functions": [
          {
            "name": "CALCULATE_DISCOUNT",
            "definition": "FUNCTION CALCULATE_DISCOUNT(AMOUNT NUMBER)\nRETURN NUMBER\nIS\nBEGIN\n    RETURN AMOUNT * 0.1;\nEND;"
          },
          {
            "name": "GET_MONTHLY_TOTAL",
            "definition": "FUNCTION GET_MONTHLY_TOTAL(YEAR_PARAM NUMBER, MONTH_PARAM NUMBER)\nRETURN NUMBER\nIS\n    V_TOTAL NUMBER;\nBEGIN\n    SELECT NVL(SUM(SALE_AMOUNT), 0) INTO V_TOTAL\n    FROM SALES\n    WHERE EXTRACT(YEAR FROM SALE_DATE) = YEAR_PARAM\n    AND EXTRACT(MONTH FROM SALE_DATE) = MONTH_PARAM;\n    \n    RETURN V_TOTAL;\nEND;"
          }
        ],
