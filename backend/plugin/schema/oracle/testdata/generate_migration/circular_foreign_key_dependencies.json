            "triggers": [
              {
                "name": "TRG_UPDATE_ORDER_TOTAL",
                "event": "INSERT OR UPDATE OR DELETE",
                "timing": "AFTER EACH ROW",
                "body": "CREATE OR REPLACE TRIGGER TRG_UPDATE_ORDER_TOTAL\nAFTER INSERT OR UPDATE OR DELETE ON ORDER_ITEMS\nFOR EACH ROW\nDECLARE\n    V_ORDER_ID NUMBER;\n    V_TOTAL NUMBER(10, 2);\nBEGIN\n    -- Get order ID\n    IF INSERTING OR UPDATING THEN\n        V_ORDER_ID := :NEW.ORDER_ID;\n    ELSE\n        V_ORDER_ID := :OLD.ORDER_ID;\n    END IF;\n    \n    -- Calculate new total\n    SELECT NVL(SUM(QUANTITY * UNIT_PRICE), 0) INTO V_TOTAL\n    FROM ORDER_ITEMS\n    WHERE ORDER_ID = V_ORDER_ID;\n    \n    -- Update order total\n    UPDATE ORDERS SET TOTAL_AMOUNT = V_TOTAL WHERE ID = V_ORDER_ID;\nEND;"
              }
            ]
          }
