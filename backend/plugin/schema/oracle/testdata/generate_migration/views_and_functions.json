        "views": [
          {
            "name": "PRODUCT_INVENTORY",
            "definition": "SELECT \n    P.ID,\n    P.NAME,\n    P.PRICE,\n    P.STOCK,\n    NVL(SUM(O.QUANTITY), 0) AS TOTAL_ORDERED\nFROM PRODUCTS P\nLEFT JOIN ORDERS O ON P.ID = O.PRODUCT_ID\nGROUP BY P.ID, P.NAME, P.PRICE, P.STOCK",
            "dependencyColumns": [
              {
                "schema": "TESTSCHEMA",
                "table": "ORDERS",
                "column": "*"
              },
