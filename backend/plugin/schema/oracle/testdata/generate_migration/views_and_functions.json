                "type": "NUMBER"
              },
              {
                "name": "TOTAL_ORDERED",
                "position": 5,
                "nullable": true,
                "type": "NUMBER"
              }
            ]
          }
        ],
        "functions": [
          {
            "name": "CALCULATE_ORDER_TOTAL",
            "definition": "FUNCTION CALCULATE_ORDER_TOTAL(P_PRODUCT_ID NUMBER, P_QUANTITY NUMBER)\nRETURN NUMBER\nIS\n    V_PRICE NUMBER(10, 2);\nBEGIN\n    SELECT PRICE INTO V_PRICE FROM PRODUCTS WHERE ID = P_PRODUCT_ID;\n    RETURN P_QUANTITY * V_PRICE;\nEXCEPTION\n    WHEN NO_DATA_FOUND THEN\n        RETURN 0;\nEND;"
          }
        ],
        "materializedViews": [
          {
            "name": "PRODUCT_STATS",
            "definition": "SELECT \n    PRODUCT_ID,\n    COUNT(*) AS ORDER_COUNT,\n    SUM(QUANTITY) AS TOTAL_QUANTITY,\n    SUM(TOTAL) AS TOTAL_REVENUE\nFROM ORDERS\nGROUP BY PRODUCT_ID\n",
            "comment": "snapshot table for snapshot TESTSCHEMA.PRODUCT_STATS",
