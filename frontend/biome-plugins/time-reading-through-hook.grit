// A value that changes with time must be read through `useTimeReading`, which
// pairs it with its own boundary and subscribes it to the shared clock. Reading
// one directly renders a label that never updates -- the staleness bug
// docs/design/timestamp-display.md exists to prevent.
//
// The rule is about the member, not the name it is reached through, so this
// matches `read` and `nextChangeAt` wherever they are named: under an alias,
// through a local or a table, via `.call`, passed as a callback, optionally
// chained, keyed by a literal, or destructured one member at a time. It also
// rejects an object that defines those members, which is what keeps readings
// in the modules below rather than assembled at a display.
//
// Two spellings escape it, both measured rather than assumed: a key held in a
// variable, and a destructure taking both members at once, which Grit's object
// snippets match by exact arity. Neither is a spelling anyone reaches for by
// accident, and the member match catches every ordinary one.
//
// `$object?.read` cannot be written as `$object?.$member` -- that snippet
// matches nothing here, so the two literal forms stay.
//
// The modules that define readings compose and build them, so biome.json
// excludes utils/datetime.ts, utils/accessGrant.ts, and the hook itself. It
// excludes every test file too, which is the larger hole: a test builds a
// reading and reads it directly, since that is how it checks one at all.
//
// Matching the member rather than the receiver reserves these two names across
// src/: a permission object spelled `{ read: true }`, or a stream reader's
// `.read()`, would be reported although neither has anything to do with time.
// Neither exists in src/ today. If one arrives, rename it or exclude the file
// in biome.json -- the rule cannot tell them apart, and that is the price of
// catching the spellings a name-based rule missed.
language js

pattern reached_past_the_hook() {
  or {
    js"$object.$member" where { or { $member <: `read`, $member <: `nextChangeAt` } },
    js"$object?.read",
    js"$object?.nextChangeAt",
    js"{ $member: $binding }" where {
      or { $member <: `read`, $member <: `nextChangeAt` }
    },
    js"{ $properties }" where { $properties <: contains or { `read`, `nextChangeAt` } },
    js"$object[$key]" where { or { $key <: `"read"`, $key <: `"nextChangeAt"` } }
  }
}

reached_past_the_hook() as $access where {
  register_diagnostic(
    span=$access,
    message="Read a time-varying value through useTimeReading(reading, input), which subscribes it to the shared clock."
  )
}
