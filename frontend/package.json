  "scripts": {
    "prepare": "sh ./scripts/copy-config-files.sh && node scripts/generate-openapi-index.js",
    "dev": "export NODE_OPTIONS=--max_old_space_size=8000 && pnpm run prepare && vite --mode dev-local",
    "release": "export NODE_OPTIONS=--max_old_space_size=8000 && pnpm run prepare && vite build --mode release --outDir=../backend/server/dist --emptyOutDir",
    "release-docker": "export NODE_OPTIONS=--max_old_space_size=8000 && pnpm run prepare && vite build --mode release",
    "release-aws": "export NODE_OPTIONS=--max_old_space_size=8000 && pnpm run prepare && vite build --mode release-aws",
    "test": "node scripts/run-gate.mjs",
    "fix": "node scripts/sort-i18n-keys.mjs && biome check --write .",
    "i18n": "node i18n.ts && pnpm fix",
    "bundle-visualize": "export NODE_OPTIONS=--max_old_space_size=80000 && vite-bundle-visualizer -c vite.config.ts",
    "test:e2e:install": "playwright install chromium"
  },
